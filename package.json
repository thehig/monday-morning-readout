{
  "name": "monday-morning-readout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "encrypt_env": "node scripts/encrypt-env.js",
    "prebuild:dev": "npm run encrypt_env",
    "build:dev": "vite build --mode development",
    "prebuild:prod": "npm run encrypt_env",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint .",
    "types:supabase": "cross-env npx supabase gen types typescript --project-id \"$PROJECT_REF\" > src/types/supabase.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:fast": "vitest run --bail 1 > fast-output.log 2>&1 && type fast-output.log"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.74.3",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "framer-motion": "^12.7.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.5.0",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@rollup/plugin-inject": "^5.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^26.1.0",
    "msw": "^2.7.5",
    "postcss": "^8.4.35",
    "supabase": ">=1.8.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-singlefile": "^1.0.0",
    "vitest": "^3.1.1"
  }
}
